{
	"schemaVersion": 1,
	"id": "spawnprotect",
	"version": "${version}",
	"name": "Spawn Protect",
	"description": "Simple serverside mod that protects spawn from PvP, explosions, etc.",
	"authors": [
		"ojace8143"
	],
	"license": "MIT",
	"icon": "assets/spawnprotect/icon.png",
	"environment": "server",
	"mixins": [
		"spawnprotect.mixins.json"
	],
	"entrypoints": {
		"main": [
			"com.ojace.spawnprotect.SpawnProtect"
		],
		"client": [
			"com.ojace8143.spawnprotect.SpawnProtect"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
